{
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "api",
    "KeyPath": "keys/jwt.key"
  },
  "ConnectionStrings": {
    "Default": "User ID=postgres;Password=postgres;Host=localhost;Port=5432;Database=Cardapius;"
  },
  "Roles": {
    "Administration": [
      "Administration.Manager",
      "Administration.Viewer"
    ]
  },
  "Authentication": {
    "UseDevelopmentCertificates": true
  },
  "RateLimiting": {
    "IpWhitelist": [
      "127.0.0.1",
      "::1",
      "10.0.0.0/8",
      "192.168.0.0/16",
      "203.0.113.42"
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
